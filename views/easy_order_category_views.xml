<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_easy_order_category_list" model="ir.ui.view">
        <field name="name">easy.order.category.list</field>
        <field name="model">easy.order.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="public_name"/>
                <field name="category_path"/>
                <field name="code"/>
                <field name="product_tmpl_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_easy_order_category_search" model="ir.ui.view">
        <field name="name">easy.order.category.search</field>
        <field name="model">easy.order.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="public_name"/>
                <field name="category_path"/>
                <field name="code"/>
                <field name="product_tmpl_ids"/>
                <filter name="top_level" string="Top-level only" domain="[('parent_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_parent" string="Parent Category" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_easy_order_category_form" model="ir.ui.view">
        <field name="name">easy.order.category.form</field>
        <field name="model">easy.order.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Internal Name"/>
                        <h1><field name="name" placeholder="e.g. Law Books"/></h1>
                        <label for="public_name" string="Display Name (what customers see)"/>
                        <h2><field name="public_name" placeholder="e.g. Books — leave blank to just use the Internal Name above"/></h2>
                        <field name="category_path" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="code" placeholder="Auto-generated from the name if left blank"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="include_subcategory_products"/>
                            <field name="product_tmpl_ids"/>
                        </page>
                        <page string="Subcategories" invisible="not child_ids">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [40, 40]}"/>
                                    <field name="name"/>
                                    <field name="public_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_easy_order_category" model="ir.actions.act_window">
        <field name="name">Easy Order Categories</field>
        <field name="res_model">easy.order.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_top_level': 1}</field>
        <field name="search_view_id" ref="view_easy_order_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Easy Order category.
            </p>
            <p>
                This is a separate structure from your real Website &gt;
                eCommerce &gt; Categories — organize it however makes
                sense for Easy Order. A TOP-LEVEL category (no Parent
                Category set) gets a web address automatically from its
                name, e.g. "Police" becomes /easy-order/police — you can
                override the Code field if you want something specific.
                Assign it the real products that should show up there.
                Subcategories don't need a code at all.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_easy_order_category"
        name="Categories"
        parent="menu_easy_order_request_root"
        action="action_easy_order_category"
        sequence="20"
    />

</odoo>
