<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_easy_order_request_list" model="ir.ui.view">
        <field name="name">easy.order.request.list</field>
        <field name="model">easy.order.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'processed'">
                <field name="request_date"/>
                <field name="create_date" string="Received"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="state" widget="badge" decoration-success="state == 'processed'" decoration-info="state == 'new'"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_easy_order_request_form" model="ir.ui.view">
        <field name="name">easy.order.request.form</field>
        <field name="model">easy.order.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_create_sale_order"
                        type="object"
                        string="Create Order"
                        class="btn-primary"
                        invisible="state == 'processed'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="new,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="customer_name" placeholder="Customer name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="request_date"/>
                            <field name="sale_order_id" readonly="1" invisible="not sale_order_id"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="probable_name" string="Customer said" readonly="1"/>
                            <field name="product_id" string="Real product"/>
                            <field name="qty"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_easy_order_request" model="ir.actions.act_window">
        <field name="name">Easy Order Requests</field>
        <field name="res_model">easy.order.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No order requests yet.
            </p>
            <p>
                These come in from the "Can't find it? Tell us" form on
                the /easy-order website. Match each line to a real
                product, then click Create Order.
            </p>
        </field>
    </record>

    <record id="view_easy_order_request_search" model="ir.ui.view">
        <field name="name">easy.order.request.search</field>
        <field name="model">easy.order.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="request_date"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_date" string="Date" context="{'group_by': 'request_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem
        id="menu_easy_order_request_root"
        name="Easy Order"
        parent="sale.sale_menu_root"
        sequence="60"
    />
    <menuitem
        id="menu_easy_order_request"
        name="Requests"
        parent="menu_easy_order_request_root"
        action="action_easy_order_request"
        sequence="10"
    />

</odoo>
